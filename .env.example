# Copy to .env locally. Never commit .env or put these values in browser JavaScript.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=bubblewash_development
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
NODE_ENV=development
# Used only by npm run backend:setup. Choose your own password, at least 12 characters.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=
